{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "yilao-discovery-edge-v111",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "https://yilaoweather.org/robots.txt*",
      "zone_name": "yilaoweather.org"
    },
    {
      "pattern": "https://yilaoweather.org/sitemap.xml*",
      "zone_name": "yilaoweather.org"
    },
    {
      "pattern": "https://yilaoweather.org/llms.txt*",
      "zone_name": "yilaoweather.org"
    },
    {
      "pattern": "https://www.yilaoweather.org/robots.txt*",
      "zone_name": "yilaoweather.org"
    },
    {
      "pattern": "https://www.yilaoweather.org/sitemap.xml*",
      "zone_name": "yilaoweather.org"
    },
    {
      "pattern": "https://www.yilaoweather.org/llms.txt*",
      "zone_name": "yilaoweather.org"
    }
  ]
}
