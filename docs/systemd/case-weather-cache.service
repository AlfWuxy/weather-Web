[Unit]
Description=Case Weather cache sync
After=network.target

[Service]
Type=oneshot
User=case-weather
Group=case-weather
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/your-app/instance /opt/your-app/storage /opt/your-app/logs
WorkingDirectory=/opt/your-app
EnvironmentFile=/opt/your-app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /opt/your-app/scripts/weather_cache_sync.sh

[Install]
WantedBy=multi-user.target
