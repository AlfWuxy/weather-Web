<view class="page-pad">
  <view class="card">
    <view class="page-title">一键提醒话术</view>
    <view class="muted page-lead">
      你作为“可信节点”把行动建议转述给家人。话术为通用建议，不提供医疗诊断/治疗建议。
    </view>
  </view>

  <view class="spacer"></view>

  <block wx:if="{{missingPair}}">
    <view class="muted empty">请先选择监测对象</view>
  </block>

  <block wx:elif="{{loading}}">
    <view class="muted empty">加载中…</view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="muted empty">加载失败</view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="muted text-sm">地点：{{locationText}}</view>
      <view class="muted text-sm meta-line">
        Tmax {{tmaxDisplay}} · Tmin {{tminDisplay}}
      </view>
      <view class="msg">{{message}}</view>
      <view class="btn-row">
        <button class="btn-primary btn-flex" bindtap="copyMessage">一键复制</button>
        <button class="btn-outline btn-flex" bindtap="back">返回</button>
      </view>
    </view>
  </block>
</view>
