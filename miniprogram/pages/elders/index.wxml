<view class="page-pad">
  <view class="card">
    <view class="row">
      <view class="page-title">监测对象</view>
      <button size="mini" class="btn-outline" bindtap="goSettings">设置</button>
    </view>
    <view class="muted page-lead">
      支持多地区；预警触发逻辑以“官方预警 + 阈值规则”为主。
    </view>
    <view class="create-wrap">
      <button class="btn-primary btn-block" bindtap="goCreate">新增老人</button>
    </view>
  </view>

  <view class="spacer"></view>

  <block wx:if="{{loading}}">
    <view class="muted empty">加载中…</view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="muted empty">加载失败，请稍后重试。</view>
  </block>

  <block wx:elif="{{elders.length === 0}}">
    <view class="muted empty">暂无老人，请先新增或在网页端添加。</view>
  </block>

  <block wx:else>
    <block wx:for="{{elders}}" wx:key="pair_id">
      <view class="card card-item">
        <view class="elder-head">
          <view class="elder-head-main">
            <view class="elder-name">
              {{item.displayName}}
              <text class="muted text-sm">{{item.relationText}}</text>
            </view>
            <view class="muted meta-line">
              地点：{{item.locationText}}
            </view>
            <view class="muted text-sm meta-line">
              Tmax {{item.tempMaxText}} · Tmin {{item.tempMinText}}
            </view>
            <view wx:if="{{item.badgeKind === 'normal' && item.hasOfficialWarning}}" class="muted text-sm meta-line">
              有官方预警
            </view>
          </view>
          <view>
            <view wx:if="{{item.badgeKind === 'heat'}}" class="badge badge-heat">高温</view>
            <view wx:elif="{{item.badgeKind === 'cold'}}" class="badge badge-cold">寒潮</view>
            <view wx:else class="badge badge-ok">正常</view>
          </view>
        </view>

        <view class="mini-row">
          <button size="mini" class="btn-outline" data-pair-id="{{item.pair_id}}" bindtap="goAlerts">预警</button>
          <button size="mini" class="btn-outline" data-pair-id="{{item.pair_id}}" bindtap="goTemplate">话术</button>
          <button size="mini" class="btn-outline" data-pair-id="{{item.pair_id}}" bindtap="goEdit">编辑</button>
        </view>
      </view>
    </block>
  </block>
</view>
