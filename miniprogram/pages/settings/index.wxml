<view class="page-pad">
  <view class="card">
    <view class="page-title">推送设置（试点）</view>
    <view class="muted page-lead">
      试点阶段使用 WxPusher 推送。填写 UID 后可开启自动推送。
    </view>

    <view class="field-lg">
      <view class="muted label">WxPusher UID</view>
      <input class="input" value="{{wxpusherUid}}" bindinput="onUid" placeholder="例如：UID_xxxxx" />
    </view>

    <view class="switch-row">
      <switch checked="{{pushEnabled}}" bindchange="onToggle" />
      <view>开启自动推送</view>
    </view>

    <view class="btn-row">
      <button class="btn-primary btn-flex" bindtap="onSave" disabled="{{busy || loading}}">保存</button>
      <button class="btn-outline btn-flex" bindtap="logout" disabled="{{busy}}">退出绑定</button>
    </view>
  </view>
</view>
