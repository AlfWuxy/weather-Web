.page {
  padding: 16px 16px 32px;
}

.center {
  text-align: center;
  padding: 20px 8px;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  margin: 8px 0 10px;
}

.pair-card {
  margin-bottom: 12px;
}

.pair-title {
  font-size: 16px;
  font-weight: 700;
}

.strip {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}

.cell {
  font-size: 11px;
  padding: 4px 6px;
  border-radius: 999px;
  min-width: 4.5rem;
  text-align: center;
}

.cell.on {
  background: #dcfce7;
  color: #166534;
}

.cell.off {
  background: #f3f4f6;
  color: #6b7280;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 16px 16px 0 0;
  padding: 16px 16px 24px;
}

.sheet-title {
  font-size: 17px;
  font-weight: 700;
}

.sheet-hint {
  font-size: 12px;
  margin-top: 6px;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
}

.picker-value {
  border: 1px solid #d1d5db;
  border-radius: 10px;
  padding: 8px 12px;
  min-width: 140px;
  text-align: right;
}

.sheet-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}
