.community-hero { background: linear-gradient(145deg, #9f3a12 0%, #9f4c1c 100%); }
.community-summary { margin: 20rpx 0; }
.filters { width: 100%; margin: 12rpx 0 22rpx; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 14rpx; padding: 2rpx; }
.filter-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 88rpx; margin: 0; padding: 14rpx 24rpx; border-radius: 999rpx; color: #685a51; background: #f3e8df; font-size: 14px; }
.filter-pill image { width: 34rpx; height: 34rpx; }
.filter-pill.active { color: #fff; background: #b64815; }
.community-card { display: flex; align-items: flex-start; gap: 20rpx; }
.rank { display: flex; flex: 0 0 54rpx; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 16rpx; color: #a34216; background: #fff0df; font-weight: 800; }
.community-copy { flex: 1; min-width: 0; }
.community-metrics { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #efe2d8; }
.community-metrics > view { display: flex; gap: 7rpx; flex-direction: column; }
.community-value { color: #8f3b16; font-size: 15px; font-weight: 800; }
.hotspot { margin-top: 16rpx; }
.community-map-card { padding: 24rpx; }
.map-heading { align-items: flex-start; margin-bottom: 18rpx; }
.map-heading-icon { width: 48rpx; height: 48rpx; }
.community-map { display: block; width: 100%; height: 500rpx; border-radius: 20rpx; overflow: hidden; }
.map-empty { display: flex; min-height: 260rpx; padding: 28rpx; border: 2rpx dashed #d8c5b7; border-radius: 20rpx; align-items: center; justify-content: center; flex-direction: column; text-align: center; }
.map-note { margin-top: 18rpx; line-height: 1.7; }
.map-selection { margin-top: 20rpx; padding: 22rpx; border: 2rpx solid #e5c7b2; border-radius: 18rpx; background: #fff7ed; }
.map-reset-button,
.map-focus-button { display: flex; min-height: 88rpx; margin: 18rpx 0 0; padding: 14rpx 22rpx; border: 2rpx solid #a34216; border-radius: 16rpx; align-items: center; justify-content: center; color: #8f3b16; background: #fffdf9; font-size: 15px; font-weight: 700; line-height: 1.4; }
.map-reset-button { width: 100%; }
.map-focus-button { width: auto; }
.map-coordinate-missing { margin-top: 18rpx; line-height: 1.6; }
.community-links { margin: 24rpx 0; }
