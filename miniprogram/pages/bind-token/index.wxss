.hint {
  font-size: 12px;
  color: #6b7280;
}

.token-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.token-input {
  flex: 1;
  width: 0;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 10px 12px;
  background: #fff;
}

.token-toggle {
  flex: none;
  margin: 0;
  padding: 0 12px;
  line-height: 36px;
  font-size: 14px;
}

.bound-hint {
  margin-top: 8px;
}
