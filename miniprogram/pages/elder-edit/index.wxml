<view class="page-pad">
  <view class="card">
    <view class="page-title">
      {{mode === 'create' ? '新增老人' : '编辑老人'}}
    </view>
    <view class="muted page-lead">
      慢病信息仅填写“类别”（可选），用于生成更贴近实际的提醒话术。
    </view>

    <view wx:if="{{loading}}" class="muted empty">加载中…</view>

    <block wx:if="{{mode === 'create'}}">
      <view class="field-lg">
        <view class="muted label">姓名/称呼</view>
        <input class="input" value="{{name}}" bindinput="onName" disabled="{{loading || busy}}" placeholder="例如：妈妈/爸爸" />
      </view>
      <view class="field">
        <view class="muted label">关系（可选）</view>
        <input class="input" value="{{relation}}" bindinput="onRelation" disabled="{{loading || busy}}" placeholder="例如：母亲/父亲" />
      </view>
      <view class="field-row">
        <view class="field-col">
          <view class="muted label">年龄（可选）</view>
          <input class="input" type="number" value="{{age}}" bindinput="onAge" disabled="{{loading || busy}}" placeholder="例如：68" />
        </view>
        <view class="field-col">
          <view class="muted label">性别（可选）</view>
          <input class="input" value="{{gender}}" bindinput="onGender" disabled="{{loading || busy}}" placeholder="男性/女性" />
        </view>
      </view>
    </block>

    <view class="field-lg">
      <view class="muted label">所在地</view>
      <input class="input" value="{{locationQuery}}" bindinput="onLocation" disabled="{{loading || busy}}" placeholder="例如：九江市都昌县/九江某乡镇" />
    </view>

    <view class="field">
      <view class="muted label">慢病类别（逗号分隔，可选）</view>
      <input class="input" value="{{chronicText}}" bindinput="onChronic" disabled="{{loading || busy}}" placeholder="例如：高血压, 糖尿病" />
    </view>

    <view class="btn-row">
      <button class="btn-primary btn-flex" disabled="{{loading || busy}}" bindtap="onSave">{{mode === 'create' ? '创建' : '保存'}}</button>
      <button class="btn-outline btn-flex" disabled="{{busy}}" bindtap="onCancel">取消</button>
    </view>
  </view>
</view>
