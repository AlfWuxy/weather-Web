# 通用示例；不包含实际机构、账户、服务器或密钥。
# 保存为 /var/lib/example-pilot/config/pilot.env，权限 0600。
# 网页、worker、beat 必须读取相同的基础配置和以下试点配置。
FEATURE_INSTITUTION_WORKBENCH=0
PILOT_STORAGE_DIR=/var/lib/example-pilot/data

# 指向私有 Redis 实例或已隔离且授权的专用队列库。
# 实际连接字符串放在独立的 secrets/pilot.env，不把密码提交到仓库。
PILOT_REDIS_URL=

# 密钥不能自动生成或临时替换；实际值仅存于 secrets/pilot.env。
# PILOT_STORAGE_KEY=<独立生成的 Fernet 密钥>

# 基础站点配置与试点密钥分开。基础 app.env 不得重复定义上述 PILOT_*。
CASE_WEATHER_ENV_FILE=/var/lib/example-pilot/config/app.env
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
